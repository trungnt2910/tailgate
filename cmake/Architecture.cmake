if(CMAKE_HOST_SYSTEM_PROCESSOR MATCHES "AMD64|x86_64")
    set(TAILGATE_HOST_ARCH "x64")
elseif(CMAKE_HOST_SYSTEM_PROCESSOR MATCHES "x86|i686")
    set(TAILGATE_HOST_ARCH "x86")
elseif(CMAKE_HOST_SYSTEM_PROCESSOR MATCHES "ARM64|aarch64")
    set(TAILGATE_HOST_ARCH "ARM64")
elseif(CMAKE_HOST_SYSTEM_PROCESSOR MATCHES "ARM|armv7")
    set(TAILGATE_HOST_ARCH "ARM")
else()
    set(TAILGATE_HOST_ARCH "${CMAKE_HOST_SYSTEM_PROCESSOR}")
endif()

if(CMAKE_SYSTEM_PROCESSOR MATCHES "AMD64|x86_64")
    set(TAILGATE_ARCH "x86_64")
elseif(CMAKE_SYSTEM_PROCESSOR MATCHES "x86|i686")
    set(TAILGATE_ARCH "i686")
elseif(CMAKE_SYSTEM_PROCESSOR MATCHES "ARM64|aarch64")
    set(TAILGATE_ARCH "aarch64")
elseif(CMAKE_SYSTEM_PROCESSOR MATCHES "ARM|armv7")
    set(TAILGATE_ARCH "armv7")
else()
    set(TAILGATE_ARCH "${CMAKE_SYSTEM_PROCESSOR}")
endif()
